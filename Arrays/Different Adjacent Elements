class Solution {
  public:
    bool distinctAdjacent(vector<int> &arr) {
        
        unordered_map<int , int > mp;
        
        for(int i = 0 ;  i < arr.size() ; i ++)
        {
            mp[arr[i]]++;
        }
        
        int n = arr.size();
        
        for(auto it = mp.begin() ; it != mp.end() ; it++)
        {
            if(it -> second > (n+1)/2)
            {
                return false;
            }
        }
        
        return true;
        
    }
};
