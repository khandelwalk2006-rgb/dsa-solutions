class Solution {
  public:
    int search(string &pat, string &txt) {
       
       unordered_map<char , int > mp1 ; 
       unordered_map<char , int > mp2 ;
       
       for(int i = 0 ; i < pat.length() ; i ++)
       {
           mp1[pat[i]] ++ ;
       }
       
       int j = 0 ; 
       int count = 0 ;
       int k = pat.length() ; 
       
       for(int i = 0 ; i < txt.length() ; i ++)
       {
           mp2[txt[i]] ++ ;
           
           if(i - j + 1 > k )
           {
               mp2[txt[j]] -- ;
               
               if(mp2[txt[j]] == 0)
               {
                   mp2.erase(txt[j]); 
               }
               
               j ++ ; 
           }
           
          if(i - j + 1 == k)
          {
              if(mp1 == mp2)
              {
                  count ++ ; 
              }
          }
       }
       
       
       return count  ;
       
       
        
    }
};
