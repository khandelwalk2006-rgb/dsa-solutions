class Solution {
public:
    int maxFrequency(vector<int>& nums, int k) {

        sort(nums.begin() , nums.end());

        int l = 0;
        long long sum = 0;
        int ans = 0 ;

        for(int r = 0 ; r < nums.size() ; r++)
        {
            sum  += nums[r];

            while(true)
            {

            long long windowLength = r - l + 1;

            long long requireSum = nums[r] * windowLength;

            long long operations = requireSum - sum ;

            if(operations <= k)
            {
                break;
            }

            else
            {
                sum -= nums[l];
                l++;
            }

           }

           ans = max(ans , r - l + 1);
        }

        return ans;
        
    }
};
