class Solution {

    bool  solve(long long  n )
    {
        if(n == 1)
        {
            return true ;
        }

        if(n <= 0 || n % 2 != 0)
        {
            return false ;
        }

        return solve(n/2 ) ;



    }

public:
    bool isPowerOfTwo(int n) {

        return solve((long long)  n) ;
        
    }
};
