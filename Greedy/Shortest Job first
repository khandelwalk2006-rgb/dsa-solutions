class Solution {
  public:
    int solve(vector<int>& bt) {
        
        
        sort(bt.begin() , bt.end());
        
        int n = bt.size(); 
        
        int time = 0 ;
        int waiting_time = 0;
        
        for(int i = 0 ; i <n-1 ; i ++)
        {
             time += bt[i] ;
             
            waiting_time  += time ;
            
           
        }
         
        return waiting_time / n ; 
             
     
        
    }
};
