class Solution {
  public:
    double fractionalKnapsack(vector<int>& val, vector<int>& wt, int capacity) {
        
        vector<pair<double, pair<int, int >>> vec ; 
        
        int n = val.size() ;
        
        for(int i =  0 ; i < n ; i ++)
        {
            int v = val[i] ; 
            int w = wt[i] ; 
            double r = (double)v / (double) w ;
            vec.push_back({r , {v , w}} ) ; 
        }
        
        sort(vec.rbegin() , vec.rend()) ; 
        double ans = 0 ; 
        
        for(int i = 0 ; i < n ; i ++)
        {
            double r = vec[i].first ; 
            int v = vec[i].second.first ; 
            int w = vec[i].second.second ;
            
            if(w <= capacity)
            {
                ans += v;
                capacity -= w ; 
            }
            
            else
            {
                ans += ((double)capacity*r) ; 
                break ;
            }
        }
        
        return ans ;
        
        
    }
};
