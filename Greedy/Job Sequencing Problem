struct Job
{
    int id;
    int deadline;
    int profit;
};

class Solution {
  public:

    static bool cmp(Job a, Job b)
    {
        return a.deadline < b.deadline;
    }

    vector<int> jobSequencing(vector<int> &deadline, vector<int> &profit) {

        int n = deadline.size();

        vector<Job> arr;

        for(int i = 0; i < n; i++)
        {
            arr.push_back({i + 1, deadline[i], profit[i]});
        }

        sort(arr.begin(), arr.end(), cmp);

        priority_queue<int, vector<int>, greater<int>> pq;

        int curr = 1;

        for(int i = 0; i < n; i++)
        {
            if(arr[i].deadline >= curr)
            {
                pq.push(arr[i].profit);
                curr++;
            }
            else
            {
                if(arr[i].profit > pq.top())
                {
                    pq.pop();
                    pq.push(arr[i].profit);
                }
            }
        }

        int total = 0;

        int job = pq.size();

        while(!pq.empty())
        {
            total += pq.top();
            pq.pop();
        }

        return {job, total};
    }
};
