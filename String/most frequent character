class Solution {
  public:
    char getMaxOccuringChar(string& s) {
        
        unordered_map<char ,char > mp ;
        
        for(int i  = 0; i < s.length() ;  i ++)
        {
            mp[s[i]] ++  ; 
        }
        
        int maxFreq = 0 ; 
        char ans ; 
        
        for(auto it : mp)
        {
            if(it.second > maxFreq)
            {
                maxFreq = it.second ;
                ans = it.first; 
            }
            
            if(maxFreq == it.second && it.first < ans)
            {
                ans = it.first;
            }
        }
        
        return ans ;
        
    }
};
