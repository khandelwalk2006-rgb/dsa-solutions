class Solution {
public:
    bool checkInclusion(string s1, string s2) {

        unordered_map<char, int > mp1;

        for(int i = 0 ; i < s1.length() ;i ++)
        {
            mp1[s1[i]] ++ ;
        }

        int k = s1.length() ; 
        int left = 0 ; 

        unordered_map<char , int> mp2 ;

        for(int right =0 ; right < s2.length() ; right ++ )
        {
            mp2[s2[right]] ++ ; 

            if(right - left +1 > k)
            {
                mp2[s2[left]] -- ;

                if(mp2[s2[left]] == 0)
                {
                    mp2.erase(s2[left]) ; 
                }

                left ++ ; 
            }

            if(right - left + 1 == k)
            {
                bool match = true ;

                for(auto it : mp1)
                {
                    if(mp1[it.first] != mp2[it.first])
                    {
                        match = false ;
                        break ;
                    }
                }

                if(match)
                {
                    return true ;
                }
            }
        }

        return false ;
        


    }
};
