class Solution {
public:
    int characterReplacement(string s, int k) {

        vector<int> freq(26 , 0);

        int l = 0; 
        int ans = 0;
        int maxFreq = 0;

        for(int r = 0 ; r < s.size() ; r ++)
        {
            char ch = s[r];
            freq[ch - 'A'] ++;

            maxFreq = max(maxFreq , freq[ch-'A']);

            int windowLength = r - l + 1;

            while(windowLength - maxFreq > k)
            {
                freq[s[l] - 'A'] --;
                l ++;

                windowLength = r - l + 1;
            }

            ans = max(ans , windowLength);
        }

        return ans;
        
    }
};
