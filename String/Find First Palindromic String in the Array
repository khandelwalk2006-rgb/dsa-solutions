class Solution {
public:
    string firstPalindrome(vector<string>& words) {

        for(int i = 0 ; i < words.size() ; i ++)
        {
            string word = words[i] ; 

            int left = 0 ;
            int right = word.size() -1 ;

            bool palindrome = true ;

            while(left < right)
            {
                if(word[left] != word[right])
                {
                    palindrome = false ;
                    break ;

                }

                left ++ ; 
                right -- ; 
            }

             if(palindrome)
            {
                return word ;
            }

          
        }

        return "";

         
        
    }
};
