
class Solution {

    int solve(TreeNode * root)
    {
           if(root == NULL)
        {
            return 0;
        }

        int sum = 0;

        if(root -> left != NULL && root -> left -> left == NULL && root -> left -> right == NULL)
        {
            sum += root -> left -> val ;
        }

        sum += solve(root -> left);

        sum += solve(root -> right );

        return sum ;
    }




public:
    int sumOfLeftLeaves(TreeNode* root) {

        return solve(root );

     
        
    }
};
