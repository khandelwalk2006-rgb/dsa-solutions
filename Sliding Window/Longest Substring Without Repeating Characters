class Solution {
public:
    int lengthOfLongestSubstring(string s) {

        unordered_map<char , int > freq;

        int l = 0, r = 0;
        int ans = 0;
        int n = s.size();

        while(r < n)
        {
            freq[s[r]] ++;

            while(freq[s[r]] > 1)
            {
                freq[s[l]]--;
                l++;
            }

            int curr_window = r - l + 1;
            ans = max(ans , curr_window);
            r++;
        }

        return ans ;
        
    }
};
