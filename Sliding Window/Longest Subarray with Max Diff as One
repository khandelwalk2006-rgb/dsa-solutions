class Solution {
  public:
    int maxLen(vector<int>& arr) {
       
       deque<int> mini;
       deque<int> maxi;
       
       int ans = 0;
       int left = 0;
       
       for(int right = 0; right < arr.size() ; right ++)
       {
           while(!maxi.empty() && arr[maxi.back()] < arr[right])
           {
               maxi.pop_back();
           }
           
           maxi.push_back(right);
           
           while(!mini.empty() && arr[mini.back()] > arr[right])
           {
               mini.pop_back();
           }
           
           mini.push_back(right);
           
           
           
           while(arr[maxi.front()] - arr[mini.front()] > 1)
           {
               if(maxi.front() == left)
               {
                   maxi.pop_front();
               }
               
               if(mini.front() == left)
               {
                   mini.pop_front();
               }
               
               left ++;
           }
           
           ans = max(ans , right - left + 1);
       }
       
       return ans;
        
    }
};
