class Solution {

    void dfs(vector<vector<char>>& grid , int row , int col)
    {
        if(row < 0 || row >= grid.size()  || col < 0 || col >= grid[0].size() || grid[row][col] == '0')
        {
            return ;
        }

        grid[row][col] = '0';

        // down
        dfs(grid , row + 1 , col);

        // left 
        dfs(grid , row , col - 1);

        // right;
        dfs(grid , row , col + 1);

        // up
        dfs(grid , row - 1 , col);

    }


public:
    int numIslands(vector<vector<char>>& grid) {

        int count  = 0;

        for(int i = 0 ; i < grid.size() ; i ++)
        {
            for(int j = 0 ; j < grid[0].size() ; j ++)
            {
                if(grid[i][j] == '1')
                {
                    count ++;
                    dfs(grid , i  , j);
                }
            }
        }

        return count ;
        
    }
};
