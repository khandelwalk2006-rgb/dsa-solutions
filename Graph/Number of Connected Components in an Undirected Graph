class Solution {

    void dfs(int startNode , vector<vector<int>> &adj, vector<int> &visited)
    {
        visited[startNode] = 1;

        for(auto neighbour : adj[startNode])
        {
            if(!visited[neighbour])
            {
                dfs(neighbour , adj , visited);
            }
        }
    }

public:
    int countComponents(int n, vector<vector<int>>& edges) {

        vector<vector<int >> adj(n);

        for(auto &edge  : edges)
        {
            int u = edge[0];
            int v = edge[1];

            adj[u].push_back(v);
            adj[v].push_back(u);
        }

        int count = 0;

        vector<int> visited(n , 0);

        for(int i = 0 ; i < n ; i ++)
        {
            if(!visited[i])
            {
                count ++; 

                dfs(i , adj , visited);
            }

        }

        return count ;


    }
};
