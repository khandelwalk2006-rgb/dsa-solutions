class Solution {

    int ans = -1;

    void  dfs(int startNode , vector<bool> &visited , vector<bool> &pathVisited , vector<int>& step , vector<int> &edges , int currStep)
    {
        
        visited[startNode] = 1;
        pathVisited[startNode] = 1;
        step[startNode] = currStep;

        int neighbour = edges[startNode];

        if(neighbour != -1)
        {
            if(!visited[neighbour])
            {
                dfs(neighbour , visited , pathVisited , step , edges , currStep + 1);
            }

            else if(pathVisited[neighbour])
        {
            ans = max(ans , currStep - step[neighbour] + 1);
        }

        }

         pathVisited[startNode] = 0;
    }


public:
    int longestCycle(vector<int>& edges) {

        int n = edges.size();

        vector<bool> visited(n , 0 );
        vector<bool> pathVisited(n , 0 );
        vector<int> step( n , 0);

      

        for(int i= 0 ; i < n; i ++)
        {
            if(!visited[i])
            {
                dfs(i , visited , pathVisited , step , edges , 0 );
                
            }
        }

        return ans;
        
    }
};
