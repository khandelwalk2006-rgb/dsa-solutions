class Solution {
public:

   vector<vector<int>> ans;

   vector<int> disc;

   vector<int> low;

   int timer = 0;

   void dfs(int u , int parent , vector<vector<int>> &adj)
   {
       disc[u] = low[u]  = timer ++ ;

       for(int v : adj[u])
       {
           if(v == parent)
           {
            continue ;
           }

            // unvisited node
           if(disc[v] == -1)
           {
              dfs(v , u , adj);

              low[u] = min(low[u] , low[v]);

              if(low[v] > disc[u])
              {
                ans.push_back({u , v});
                 
              }

           }

            // back edge 
           else
           {
              low[u] = min(low[u] , disc[v]);
           }
       }
    
       
   }


    vector<vector<int>> criticalConnections(int n, vector<vector<int>>& connections) {

        vector<vector<int >> adj(n);

        for(auto &edge : connections)
        {
            int u = edge[0];
            int v = edge[1];

            adj[u].push_back(v);
            adj[v].push_back(u);
        }

         disc.assign(n , -1);
         low.resize(n);

         dfs(0 , -1 , adj);

         return ans;
        
    }
};
