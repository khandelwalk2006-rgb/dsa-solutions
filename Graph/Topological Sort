class Solution {
    
    void topological(int startNode , vector<int> &visited , vector<vector<int>> & adj , stack<int>
 &s )
    {
        visited[startNode] = true;
        
        for(auto neighbour : adj[startNode])
        {
            if(!visited[neighbour])
            {
                topological(neighbour , visited , adj , s);
            }
        }
        
        s.push(startNode);
        
    }
    
  public:
    vector<int> topoSort(int V, vector<vector<int>>& edges) {
        
        vector<vector<int>> adj(V);
        
        for(int i = 0 ; i < edges.size() ; i ++)
        {
            int u = edges[i][0];
            int v = edges[i][1];
            
            adj[u].push_back(v);
        }
        
        vector<int> visited(V , false);
        stack<int> s;
        
        for(int i = 0 ; i < V; i ++)
        {
            if(!visited[i])
            {
                topological(i , visited , adj , s);
            }
        }
        
        vector<int> ans;
        
        while(!s.empty())
        {
            ans.push_back(s.top());
            s.pop();
        }
        
        return ans;
      
        
    }
};
