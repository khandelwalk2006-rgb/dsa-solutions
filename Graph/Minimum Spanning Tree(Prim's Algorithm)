class Solution {
  public:
    int spanningTree(int V, vector<vector<int>>& edges) {
           
          vector<vector<pair<int , int>>> adj(V);
          
          for(auto &edge : edges)
          {
              int u = edge[0];
              int v = edge[1];
              int w = edge[2];
              
              adj[u].push_back({v , w});
              adj[v].push_back({u , w});
              
          }
          
          priority_queue<pair<int , int> , vector<pair<int , int>> , greater<pair<int , int>>> pq;
          
          pq.push({0,0});
          
          int ans = 0;
          
          vector<int> visited(V , 0);
          
          while(!pq.empty())
          {
              auto [weight, u] = pq.top();
              pq.pop();
              
              if(visited[u])
              {
                  continue;
              }
              
              ans += weight;
              
              visited[u] = 1;
              
              for(auto &it : adj[u])
              {
                  int v = it.first;
                  int wt = it.second;
                  
                  if(!visited[v])
                  {
                      pq.push({wt , v});
                  }
              }
          }
          
          return ans;
    }
};
