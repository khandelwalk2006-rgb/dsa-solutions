class Solution {
  public:
  
     vector<int> ans;
     vector<int> disc;
     vector<int> low;
     
     int timer = 0;
     
     void dfs(int u , int parent , vector<vector<int>> &adj)
     
     {
         low[u] = disc[u] = timer ++ ;
         
         int children = 0;
         bool  articulation = false;
         
         for(int v  : adj[u])
         {
             if(v == parent)
             {
                 continue;
             }
             
             if(disc[v] == -1)
             {
                 children ++;
                 
                 dfs(v , u , adj);
                 
                 low[u] = min(low[u] , low[v]);
                 
                 if(parent != -1 && low[v] >= disc[u])
                 {
                     articulation = true;
                 }
             }
             
             else
             {
                 low[u ] = min(low[u] , disc[v]);
             }
         }
         
         if(parent == -1 && children > 1)
         {
             articulation  = true;
         }
         
         if(articulation)
         {
             ans.push_back(u);
         }
         
         
     }
  
  
    vector<int> articulationPoints(int V, vector<vector<int>>& edges) {
    
          vector<vector<int>> adj(V);
          
          for(auto edge : edges)
          {
              int u = edge[0];
              int v = edge[1];
              
              adj[u].push_back(v);
              adj[v].push_back(u);
          }
          
          disc.assign(V , -1);
          low.resize(V);
          
          timer = 0;
          ans.clear();
          
          for(int i = 0 ;  i < V  ; i ++)
          {
              if(disc[i] == -1)
              {
                  dfs(i , -1 , adj);
              }
          }
          
          if(ans.empty())
          {
              return {-1};
              
              
          }
          
          
          return ans;
          
          
        
    }
};
