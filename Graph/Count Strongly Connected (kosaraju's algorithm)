class Solution {
    
    void dfs1(int u , vector<vector<int>> &adj  , vector<int> &visited , stack<int> &st)
    {
        visited[u] = 1;
        
        for(auto v : adj[u])
        {
            if(!visited[v])
            {
                dfs1(v , adj , visited , st);
            }
        }
        
        st.push(u);
    }
    
    void dfs2(int u , vector<vector<int>> &rev , vector<int>  &visited)
    {
        visited[u] = 1;
        
        for(auto v : rev[u])
        {
            if(!visited[v])
            {
                dfs2(v , rev , visited);
            }
        }
    }
    
    
    
  public:
    int kosaraju(int V, vector<vector<int>> &edges) {
        
        vector<vector<int>> adj(V);
        
        for(auto & edge  : edges)
        {
            int u = edge[0];
            int v = edge[1];
            
            adj[u].push_back(v);
        }
        
        vector<int> visited(V , 0);
        stack<int> st;
        
        for(int i = 0; i < V; i ++)
        {
            if(!visited[i])
            {
                dfs1(i , adj , visited , st);
            }
        }
        
        vector<vector<int>> rev(V);
        
        for(int u = 0; u < V ; u ++)
        {
            for(auto v : adj[u])
            {
                rev[v].push_back(u);
            }
        }
        
        fill(visited.begin()  , visited.end() , 0);
        
        int scc = 0;
        
        while(!st.empty())
        {
            int u = st.top();
            st.pop();
            
         
                if(!visited[u])
                {
                    dfs2(u , rev , visited);
                    scc++;
                    
                }
            
        }
        
        return scc;
    
        
        
        
    }
};
