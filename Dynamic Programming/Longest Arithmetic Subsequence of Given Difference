class Solution {
public:
    int longestSubsequence(vector<int>& arr, int difference) {

        int n = arr.size();

        int ans = 1 ;

        unordered_map<int , int > dp(n);

        for(int i =0 ; i < arr.size() ; i ++)
        {
            int previous = arr[i] - difference;

            if(dp.count(previous))
            {
                dp[arr[i]] = dp[previous] + 1 ;
            }

            else
            {
                dp[arr[i]] = 1 ;
            }

            ans =  max(ans , dp[arr[i]]);
        }

        return ans  ;


        
    }
};
