class Solution {
  public:
    int derangeCount(int n) {
        
        
        vector<int> dp(n + 1  , INT_MAX);
        
        
        
        int prev2 = 1;
        
        int prev1  = 0;
        
        for(int i = 2 ; i <= n ; i ++)
        {
           int ans   = (i-1) *  (prev2 + prev1);
           
            
            prev2 = prev1 ;
            prev1 = ans ;
        }
        
        return prev1;
        
