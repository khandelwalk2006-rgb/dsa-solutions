class Solution {

    int solve(vector<int> & days , vector<int> & costs , int index , vector<int> & dp)
    {
        int n = days.size();

        if(index >= n)
        {
            return 0 ;
        }

        if(dp[index] != -1)
        {
            return dp[index];
        }

        int oneDay =  costs[0]  + solve(days , costs , index + 1 , dp);

        int  i = index;

        while(i < n && days[i] < days[index] + 7)
        {
            i ++ ;

        }

        int secondDay  = costs[1] + solve(days , costs , i, dp);

        i = index;

        while(i < n && days[i] < days[index] + 30)
        {
            i ++;
        }

        int thirdDay = costs[2] + solve(days , costs , i , dp);

        dp[index] =  min(oneDay  , min(secondDay , thirdDay));

        return dp[index];

    }


public:
    int mincostTickets(vector<int>& days, vector<int>& costs) {

        int n = days.size();

        vector<int> dp(n + 1 , -1); 

        return solve(days , costs  , 0 , dp);
        
    }
};
