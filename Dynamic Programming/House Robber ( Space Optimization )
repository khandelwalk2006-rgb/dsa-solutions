class Solution {

    int solve(vector<int> &nums)
    {
        int n = nums.size();

        if(n == 1)
        {
           return  nums[0];
        }


        
          int prev2 = nums[0] ;

      
        int prev1 = max(nums[0] , nums[1]);

        for(int i = 2  ; i < n ; i ++)
        {
            int include = prev2  + nums[i];
            int exclude = prev1  + 0 ;

            int ans = max(include , exclude);

            prev2 = prev1 ;
            prev1 = ans ;

            
        }

        return prev1 ;
    }

public:
    int rob(vector<int>& nums) {

        int n = nums.size();

        if(n == 1)
        {
            return nums[0];
        }
        

        vector<int> first;
        vector<int> last;

        for(int i = 0 ; i  < n ; i ++)
        {
            if(i != n-1)
            {
                first.push_back(nums[i]);
            }

            if(i != 0)
            {
                last.push_back(nums[i]);
            }
        }
        
        return max(solve(first) , solve(last));




    }
};
