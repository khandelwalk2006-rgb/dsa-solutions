class Solution {
public:
    int longestArithSeqLength(vector<int>& nums) {

        int n = nums.size();

        if(n <= 2)
        {
            return n ;


        }

        int ans = 2;

        vector<unordered_map<int , int >> dp(n);

        for(int i = 0 ; i < n ; i ++)
        {
            for(int j = 0 ; j < i ; j ++)
            {
                int difference = nums[i] - nums[j];

                if(dp[j].count(difference))
                {
                    dp[i][difference] = dp[j][difference] + 1 ;
                }

                else
                {
                    dp[i][difference] = 2 ;
                }

                ans = max(ans , dp[i][difference]);
                
            }
        }

        return ans ;
        
    }
};
