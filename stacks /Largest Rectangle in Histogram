class Solution {
public:
    int largestRectangleArea(vector<int>& heights) {

        stack<int> st;
        int ans = 0 ;

        for(int i = 0; i < heights.size() ; i ++)
        {
            while(!st.empty() && heights[st.top()] > heights[i])
            {
                int h = heights[st.top()];
                st.pop();

                int width ; 

                if(st.empty())
                {
                    width = i ;
                }

                else
                {
                    width = i - st.top() - 1;
                }

                ans = max(ans , h * width);

             
            }

               st.push(i);
        }

            while(!st.empty())
            {
                int h = heights[st.top()];
                st.pop();

                int width;

                if(st.empty())
                {
                    width = heights.size();
                }

                else
                {
                    width  = heights.size() - st.top()  - 1;
                }

                ans = max(ans , h * width);
            }

            return ans;

        
        
    }
};
