class Solution {
public:
    int minStartValue(vector<int>& nums) {

        int prefix = 0 ; 
        int minPrefix = 0 ; 

        for(int i = 0 ; i < nums.size() ; i ++)
        {
            prefix = prefix + nums[i] ;

            minPrefix = min(minPrefix , prefix) ; 
        }
        
        return 1 - minPrefix ;
    }
};
