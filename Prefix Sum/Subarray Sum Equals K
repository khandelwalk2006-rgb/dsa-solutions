class Solution {
public:
    int subarraySum(vector<int>& nums, int k) {

        unordered_map<int , int > mp ; 

        int prefix = 0 ; 
        int count = 0 ; 

        mp[0] = 1 ; 

        for(int i = 0 ; i < nums.size() ; i ++)
        {
            prefix = prefix + nums[i] ; 

            int require = prefix  - k  ;
            
            if(mp.find(require) != mp.end())
            {
                count = count + mp[require] ; 
            }

            mp[prefix] ++  ;
        }

        return count ; 

    }
};
