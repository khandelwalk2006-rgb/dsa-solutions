class Solution {

    bool isSafe(int row , int col , vector<vector<char>>& soduko , int val)
    {
        for(int i= 0 ; i < soduko.size(); i ++)
        {
            if(soduko[row][i] == val)
            {
                return false;
            }

            if(soduko[i][col] == val)
            {
                return false;
            }

            if(soduko[3*(row/3) + i/3][3 * (col/3) + i%3] == val)
            {
                return false;
            }
        }

        return true;
    }

    bool solve(vector<vector<char>>& soduko)
    {
        int n = soduko.size();

        for(int row = 0; row < n;  row ++)
        {
            for(int col = 0 ; col < n ; col ++)
            {
                // cell empty

                if(soduko[row][col] == '.')
                {
                    for(char val = '1' ; val <= '9' ; val ++)
                    {
                        if(isSafe(row , col , soduko , val))
                        {
                            soduko[row][col] = val;

                            // recusrive call

                            if(solve(soduko))
                            {
                                return true;
                            }
                        }

                        // backtrack 
                        soduko[row][col] = '.';
                    }

                    return false;
                }
            }

        }

        return true;
    }


public:
    void solveSudoku(vector<vector<char>>& board) {

        solve(board);
        
    }
};
