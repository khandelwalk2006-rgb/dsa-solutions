class Solution {
public:
    int countGoodSubstrings(string s) {

        int left = 0 ; 
        int ans = 0; 

        for(int right = 0 ; right < s.size() ; right ++)
        {
            if(right - left + 1 == 3)
            {
                set<int> st ;

                for(int i = left ; i <= right ; i ++)
                {
                    st.insert(s[i]);
                }

                if(st.size() == 3)
                {
                    ans ++  ; 
                }

                left ++ ; 
            }
        }

        return ans ;
        
    }
};
