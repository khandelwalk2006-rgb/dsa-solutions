class Solution {
  public:
    vector<int> firstNegInt(vector<int>& arr, int k) {
        
        int left = 0; 
        vector<int> ans ;
        deque<int> dq ;
        
        for(int right = 0; right < arr.size() ; right++)
        {
            if(arr[right] < 0)
            {
                dq.push_back(arr[right]) ; 
            }
            
            if(right - left + 1 == k )
            {
                 
            if(!dq.empty())
            {
                ans.push_back(dq.front()) ; 
            }
            
            else
            {
                ans.push_back(0) ;
            }
            
            if(arr[left] < 0)
            {
                dq.pop_front() ;
            }
            
            left ++ ;
                
            }
           
        }
        
        return ans ;
       
        
    }
};
