class Solution {
public:
    int maxSatisfied(vector<int>& customers, vector<int>& grumpy, int minutes) {

        int left = 0 ;
        int extra = 0;
        int ans =0 ; 
        int base =  0 ;

        for(int right = 0 ; right < customers.size() ; right ++)
        {
            if(grumpy[right] == 0)
            {
                base += customers[right] ; 

            }
            if(grumpy[right] == 1)
            {
                extra += customers[right] ; 
            }

            if(right - left + 1 == minutes)
            {
                ans = max(ans , extra ) ;

                if(grumpy[left] == 1)
                {
                    extra -= customers[left ] ;
                }

                left ++ ;

            }
        }

        return ans + base ;
        
    }
};
