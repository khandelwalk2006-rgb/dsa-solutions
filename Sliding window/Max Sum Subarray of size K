class Solution {
  public:
    int maxSubarraySum(vector<int>& arr, int k) {
        
        int left = 0; 
        int ans =0 ;
        
        int sum = 0 ;
        
        for(int right = 0 ; right < arr.size() ; right ++ )
        {
            sum += arr[right] ; 
            
            if(right - left + 1 == k)
            {
                ans = max(ans , sum ) ; 
                
                sum -= arr[left] ; 
                left ++ ; 
                
                
            }
        }
        
        return ans ;
        
    }
};
