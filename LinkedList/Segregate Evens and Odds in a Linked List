

class Solution {
  public:
    Node* divide(Node* head) {
        
        if(head == NULL || head -> next == NULL)
        {
            return head;
        }
        
        Node* evenHead = NULL;
        Node* evenTail = NULL;
        
        Node* oddHead = NULL;
        Node* oddTail = NULL;
        
        Node* curr = head;
        
        while(curr  != NULL)
        {
            if(curr -> data % 2  == 0)
            {
                
             if(evenHead == NULL)
            {
                evenHead = curr;
                evenTail = curr;
            }
            else
            {
                evenTail -> next = curr;
                evenTail =  curr;
            }
                
           }
           
           else
           {
               if(oddHead == NULL)
               {
                   oddHead = curr;
                   oddTail = curr;
               }
               
               else
               {
                   oddTail -> next = curr;
                   oddTail = curr;
               }
           }
           
           curr = curr -> next;
           
        }
        
        if(evenHead == NULL)
           {
               return oddHead;
           }
           
           evenTail -> next = oddHead;
           
           if(oddTail != NULL)
           {
               oddTail -> next = NULL;
               
           }
           
           return evenHead;
        
    }
};
