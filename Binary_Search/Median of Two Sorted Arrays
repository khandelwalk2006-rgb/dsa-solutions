class Solution {
public:
    double findMedianSortedArrays(vector<int>& nums1, vector<int>& nums2) {

        int n1 = nums1.size();
        int n2 = nums2.size() ; 

        int total = n1 + n2;

        int mid2 = total / 2  ; 
        int mid1 = mid2 - 1 ;

        int i = 0 ; 
        int j = 0 ;
        
        int count = 0 ;
        
        int val1 = -1;
        int val2 = -1;

        while(i < n1  && j < n2)
        {
            if(nums1[i] < nums2[j])
            {
                if(count == mid1)
                {
                    val1 = nums1[i];
                }

                if(count == mid2)
                {
                    val2 = nums1[i];
                }

                i ++ ;

            }

            else
            {
                if(count == mid1)
                {
                    val1 = nums2[j];
                }

                if(count == mid2)
                {
                    val2 = nums2[j];
                }

                j++ ;
            }

            count ++ ; 
        }

        while(i < n1)
        {
            if(count == mid1)
            {
                val1 = nums1[i];

            }

            if(count == mid2)
            {
                val2 = nums1[i];
            }

            i ++ ;
            count ++ ;
        }

        while(j < n2)
        {
            if(count == mid1)
            {
                val1 = nums2[j];
            }

            if(count == mid2)
            {
                val2 = nums2[j];
            }

            j++;
            count ++ ;
        }

        // odd case
        if(total % 2 != 0)
        {
            return val2 ;
        }

        // even case 
        return (val1 + val2) / 2.0 ;
        
    }
};
