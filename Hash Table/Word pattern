class Solution {
public:
    bool wordPattern(string pattern, string s) {

        map<char , string> mp1; 
        map<string , char> mp2 ;

        string word = "";
        int i = 0 ; 

        for(int j = 0 ; j <= s.size() ; j ++)
        {
            if(j < s.size() && s[j] != ' ')
            {
                word += s[j] ;
            }

            else
            {
                if(i == pattern.size())
                {
                    return false ;
                }


                
            char ch = pattern[i];

            if(mp1.count(ch) && mp1[ch] != word)
            {
                return false ;
            }

            if(mp2.count(word ) && mp2[word] != ch)
            {
                return false ;
            }

            mp1[ch] = word;
            mp2[word] = ch ;

            word = "";
            i ++ ;

            }


        }

        return i == pattern.size() ;
        
    }
};
